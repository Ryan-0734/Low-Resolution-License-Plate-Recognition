def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mode", choices=["build", "peek", "predict_one", "eval_tracks", "predict_tracks"], required=True)

    ap.add_argument("--root", required=True,
                    help=r'Root chứa track_**** (ví dụ: "D:\da ta\Brazilian")')
    ap.add_argument("--model_out", default=r"D:\LRLPR\char_memory_model_v6.npz")
    ap.add_argument("--model_in",  default=r"D:\LRLPR\char_memory_model_v6.npz")
    ap.add_argument("--out_txt",   default=r"D:\LRLPR\pred_v6.txt")
    ap.add_argument("--img", default="")
    ap.add_argument("--expected_len", type=int, default=7)

    ap.add_argument("--max_tracks", type=int, default=0)
    ap.add_argument("--frames_per_track", type=int, default=3)
    ap.add_argument("--debug_first_n", type=int, default=1)

    args = ap.parse_args()

    if args.mode == "peek":
        shown = 0
        for tdir in iter_tracks(args.root):
            print(os.path.basename(tdir), "=>", read_label_from_annotations(tdir))
            shown += 1
            if shown >= 10:
                break
        return

    if args.mode == "build":
        build_memory(
            root=args.root,
            model_out=args.model_out,
            expected_len=args.expected_len,
            max_tracks=args.max_tracks,
            frames_per_track=args.frames_per_track,
            debug_n=args.debug_first_n,
        )
        return

    if args.mode == "predict_one":
        if not args.img:
            raise RuntimeError("Thiếu --img")
        mem = CharMemory.load(args.model_in)
        g = imread_gray(args.img)
        if g is None:
            raise RuntimeError("Không đọc được ảnh: " + args.img)
        dbg = os.path.join(os.path.dirname(args.img), "_one_dbg")
        plate, conf, chars, probs, tops = predict_plate(mem, g, expected_len=args.expected_len, debug_dir=dbg, tag="ONE")
        print("PLATE:", plate, "CONF:", conf)
        for i in range(len(chars)):
            print(" pos", i, "pred", chars[i], "p", probs[i], "top", tops[i])
        return

    if args.mode == "eval_tracks":
        eval_on_root(
            mem_path=args.model_in,
            root=args.root,
            expected_len=args.expected_len,
            max_tracks=args.max_tracks,
            debug_first_n=args.debug_first_n,
        )
        return

    if args.mode == "predict_tracks":
        predict_tracks_to_file(
            mem_path=args.model_in,
            root=args.root,
            out_txt=args.out_txt,
            expected_len=args.expected_len,
            max_tracks=args.max_tracks,
            debug_first_n=args.debug_first_n,
        )
        return


if __name__ == "__main__":
    main()
