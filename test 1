def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mode", choices=["build", "peek", "predict_one", "predict_tracks"], required=True)
    ap.add_argument("--train_root", default=r"D:\LRLPR\data\train")
    ap.add_argument("--test_root", default=r"D:\LRLPR\data\test_public")
    ap.add_argument("--model_out", default=r"D:\LRLPR\char_memory_model.npz")
    ap.add_argument("--model_in", default=r"D:\LRLPR\char_memory_model.npz")
    ap.add_argument("--out_txt", default=r"D:\LRLPR\predictions_char_memory.txt")
    ap.add_argument("--img", default="")
    ap.add_argument("--max_tracks", type=int, default=0)     # 0 = dùng tất cả
    ap.add_argument("--expected_len", type=int, default=7)   # ICPR Brazil thường 7
    ap.add_argument("--no_ecc", action="store_true")         # tắt ECC align
    ap.add_argument("--fuse_mode", choices=["mean", "median"], default="mean")
    args = ap.parse_args()

    if args.mode == "peek":
        tracks = sorted([d for d in os.listdir(args.train_root) if d.startswith("track_")])[:10]
        for tid in tracks:
            tdir = os.path.join(args.train_root, tid)
            lb = read_label_from_annotations(tdir)
            print(tid, "=>", lb)
        return

    exp = args.expected_len if (args.expected_len is not None and args.expected_len > 0) else None

    if args.mode == "build":
        mx = args.max_tracks if args.max_tracks > 0 else None
        build_memory(args.train_root, args.model_out, max_tracks=mx, debug_n=3, expected_len=exp)

    elif args.mode == "predict_one":
        mem = CharMemory.load(args.model_in)
        if not args.img:
            raise RuntimeError("Thiếu --img")

        g = imread_gray(args.img)
        if g is None:
            raise RuntimeError("Không đọc được ảnh: " + args.img)

        dbg = os.path.join(os.path.dirname(args.img), "_one_dbg")
        plate, conf, chars, probs, tops = predict_plate(mem, g, expected_len=exp, debug_dir=dbg, tag="ONE")

        plate = norm_text(plate)
        if exp is not None and len(plate) != exp:
            plate, conf = "UNKNOWN", 0.0

        print("PLATE:", plate, "CONF:", conf)
        for i in range(len(chars)):
            print(" pos", i, "pred", chars[i], "p", probs[i], "top", tops[i])

    elif args.mode == "predict_tracks":
        run_predict_tracks(
            args.model_in,
            args.test_root,
            args.out_txt,
            debug_first_n=1,
            expected_len=exp,
            use_ecc=(not args.no_ecc),
            fuse_mode=args.fuse_mode,
        )

if __name__ == "__main__":
    main()

